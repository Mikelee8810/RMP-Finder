{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mikelee8810/RMP-Finder/data/restaurant.schema.json",
  "title": "RMP Finder restaurant record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rmpKey",
    "officialName",
    "officialAddress",
    "borough",
    "zip",
    "coordinates",
    "rmpVerifiedAt",
    "businessStatus",
    "hoursStatus"
  ],
  "properties": {
    "rmpKey": {
      "type": "string",
      "minLength": 1
    },
    "officialName": {
      "type": "string",
      "minLength": 1
    },
    "currentName": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "officialAddress": {
      "$ref": "#/$defs/address"
    },
    "currentAddress": {
      "anyOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "type": "null"
        }
      ]
    },
    "borough": {
      "type": "string",
      "minLength": 1
    },
    "zip": {
      "type": "string",
      "pattern": "^[0-9]{5}(-[0-9]{4})?$"
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "menuUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "imageAttribution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sourceUrl", "credit"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "credit": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] }
      }
    },
    "businessStatus": {
      "type": "string",
      "enum": [
        "open",
        "likely_open",
        "temporarily_closed",
        "likely_closed",
        "closed",
        "moved",
        "rebranded",
        "conflicting",
        "unknown"
      ]
    },
    "hoursStatus": {
      "type": "string",
      "enum": [
        "verified",
        "usable",
        "stale",
        "partial",
        "conflicting",
        "unknown"
      ]
    },
    "hours": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": ["timezone", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "properties": {
        "timezone": { "const": "America/New_York" },
        "monday": { "$ref": "#/$defs/dayPeriods" },
        "tuesday": { "$ref": "#/$defs/dayPeriods" },
        "wednesday": { "$ref": "#/$defs/dayPeriods" },
        "thursday": { "$ref": "#/$defs/dayPeriods" },
        "friday": { "$ref": "#/$defs/dayPeriods" },
        "saturday": { "$ref": "#/$defs/dayPeriods" },
        "sunday": { "$ref": "#/$defs/dayPeriods" }
      }
    },
    "rmpVerifiedAt": {
      "type": "string",
      "format": "date"
    },
    "businessCheckedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "conflictFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "name_mismatch",
          "address_mismatch",
          "moved",
          "rebranded",
          "hours_conflict",
          "status_conflict",
          "phone_conflict"
        ]
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "role",
          "checkedAt"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["rmp_eligibility", "business_status", "hours", "phone", "website", "address", "coordinates", "image"]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line1",
        "city",
        "state",
        "zip"
      ],
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1
        },
        "line2": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "const": "NY"
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "addressRole",
        "provider",
        "matchQuality",
        "precision",
        "checkedAt"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": 40.4,
          "maximum": 41.5
        },
        "longitude": {
          "type": "number",
          "minimum": -74.5,
          "maximum": -73.4
        },
        "addressRole": { "type": "string", "enum": ["official_rmp", "current_business"] },
        "provider": { "type": "string", "minLength": 1 },
        "matchQuality": { "type": "string", "enum": ["exact", "matched", "approximate", "manual", "unmatched"] },
        "precision": {
          "type": "string",
          "enum": [
            "rooftop",
            "parcel",
            "street",
            "interpolated",
            "approximate",
            "unknown"
          ]
        },
        "checkedAt": { "type": "string", "format": "date" },
        "matchedAddress": { "type": ["string", "null"] }
      }
    },
    "dayPeriods": {
      "type": "array",
      "items": { "$ref": "#/$defs/timePeriod" }
    },
    "timePeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open",
        "close"
      ],
      "properties": {
        "open": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "close": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
        }
      }
    }
  }
}
