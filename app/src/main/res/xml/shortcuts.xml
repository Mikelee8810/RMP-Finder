<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_now"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_open_near_me_short"
        android:shortcutLongLabel="@string/shortcut_open_near_me_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.mike.rmpfinder"
            android:targetClass="com.mike.rmpfinder.MainActivity">
