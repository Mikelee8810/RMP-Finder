            android:action="android.intent.action.VIEW"
            android:targetPackage="com.mike.rmpfinder"
            android:targetClass="com.mike.rmpfinder.MainActivity">
            <extra android:name="action_shortcut" android:value="saved" />
        </intent>
    </shortcut>
